# ======================================================
# JobFlow — Environment Configuration
# Copy this file to .env and fill in your keys.
# NEVER commit the real .env file.
# ======================================================

# --- App ---
# 32-char random hex for encrypting API keys/tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-32-char-random-hex
NEXTAUTH_SECRET=replace-with-32-char-random-hex

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- AI Provider API Keys (add at least one) ---
# Provider available: openai | anthropic | google | groq

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com — fast + free tier)
GROQ_API_KEY=

# --- Optional: pre-configured default provider/model ---
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# --- Google OAuth (for Gmail sending) ---
# Create at https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Redirect URI must match: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Tectonic (LaTeX compiler) ---
# If empty, "tectonic" is used (must be on PATH)
# Or provide a full path to the binary, e.g. C:\tools\tectonic\tectonic.exe
TECTONIC_PATH=